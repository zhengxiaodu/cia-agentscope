# 管理中心配置（用户鉴权 / 意图卡片 地址分离）
MNG_AUTH_URL=http://localhost:7009
MNG_INTENT_URL=http://localhost:7009

# 外部技能目录（mng系统外部意图关联的skill存放路径）
EXTERNAL_SKILLS_DIR=./external_skills

# Docker 工作区管理器配置
WORKSPACE_BASE_IMAGE=python:3.13-slim
# 工作区根目录（挂载到宿主机）
WORKSPACE_BASEDIR=/data/docker-workspaces
# 工作区闲置清理时间
WORKSPACE_TTL=3600
# 工作区目录存活最长天数
WORKSPACE_RETENTION_DAYS=7
# 清理扫描间隔
WORKSPACE_CLEANUP_INTERVAL_HOURS=24

# Python 包安装源（为空则不设置容器 env，使用默认源）
PIP_INDEX_URL=
PIP_TRUSTED_HOST=

# ---- 工作区后端选择 ----
# docker: 使用 agentscope DockerWorkspace（单机 Docker，默认）
# opensandbox: 使用 OpenSandbox SDK（K8s 沙箱集群）
WORKSPACE_BACKEND=docker

# OpenSandbox 沙箱配置（替代 Docker 工作区，WORKSPACE_BACKEND=opensandbox 时生效）
OPENSANDBOX_DOMAIN=localhost:9080
OPENSANDBOX_API_KEY=
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_IMAGE=python:3.13-slim
OPENSANDBOX_RESOURCE_CPU=100m
OPENSANDBOX_RESOURCE_MEMORY=128Mi
# 预热池：提前创建 N 个空闲沙箱，首次请求直接分配（0=不启用）
OPENSANDBOX_POOL_SIZE=0
# 池中沙箱被取出后是否自动补充
OPENSANDBOX_POOL_REFILL=true

# 知识库配置
RAGFLOW_API_KEY=
RAGFLOW_BASE_URL=

# 制度问答配置（policy_qa 技能）
POLICY_QA_BASE_URL=http://25.59.38.160:6181
# 权限名→知识库ID 映射（JSON，留空则用代码默认值）
POLICY_QA_KB_MAP=

# MinerU 文档解析配置（鉴权头为 x-api-key，非 Authorization）
MINERU_API_KEY=
MINERU_BASE_URL=
