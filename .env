JWT_EXPIRE_HOURS=1

# 第三方管理系统登录校验接口(暂未启用,使用模拟数据)
AUTH_MOCK=true
AUTH_API_URL=https://example.com/api/auth/verify

# Redis 会话存储配置（保留，用于其他需求）
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=86400

# MySQL 会话持久化配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
