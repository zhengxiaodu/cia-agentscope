MYSQL_DATABASE=agentscope

# 文件上传配置
UPLOAD_MAX_SIZE_MB=10

# Langfuse 可观测性配置
LANGFUSE_PUBLIC_KEY=pk-lf-8a971ada-d691-4c57-b1c4-df081c3881e2
LANGFUSE_SECRET_KEY=sk-lf-6d3177f5-fdcf-4e01-8d71-5eb157a8e4e7
LANGFUSE_HOST=https://us.cloud.langfuse.com

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=67108864
LOG_BACKUP_COUNT=7

# 管理中心配置（用户鉴权 / 意图卡片 地址分离）
MNG_AUTH_URL=http://localhost:7009
MNG_INTENT_URL=http://localhost:7009

# 外部技能目录（mng系统外部意图关联的skill存放路径）
EXTERNAL_SKILLS_DIR=./external_skills

# OpenSandbox 沙箱配置
OPENSANDBOX_DOMAIN=localhost:9080
OPENSANDBOX_API_KEY=
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_IMAGE=registry.ccdc.cn:5000/library/python:3.13-slim
OPENSANDBOX_RESOURCE_CPU=100m
OPENSANDBOX_RESOURCE_MEMORY=128Mi
# 工作区空闲 TTL（秒），供 OpenSandboxWorkspaceManager 淘汰空闲沙箱
WORKSPACE_TTL=7200
# 预热池：提前创建 N 个空闲沙箱，首次请求直接分配（0=不启用）
OPENSANDBOX_POOL_SIZE=0
# 池中沙箱被取出后是否自动补充
OPENSANDBOX_POOL_REFILL=true


# 制度问答配置（policy_qa 技能）
# 权限名→知识库ID 映射（JSON，留空则用代码默认值）
POLICY_QA_KB_MAP=

# MinerU 文档解析配置（鉴权头为 x-api-key，非 Authorization）
MINERU_API_KEY=
MINERU_BASE_URL=

# 安全敏感内容检测配置
# 安全审核总开关（false 时输入输出均不做安全审核）
SENSITIVE_ENABLED=true
# 敏感检测服务地址（基础地址 IP+端口，路径由服务代码按场景拼接），留空则关闭检测
SENSITIVE_SERVICE_URL=http://25.59.38.152:30017
# 语义风险阈值（0.0-1.0）
SENSITIVE_THRESHOLD=0.7
# 调用超时（秒），超时兜底放行
SENSITIVE_TIMEOUT=5
