# 敏感配置加密主密钥
# JWT 鉴权配置
# 敏感配置加密：JWT_SECRET / MYSQL_PASSWORD 支持写成 ENC(<base64密文>) 形式，
# 启动时用 CONFIG_DECRYPT_KEY 解密。生成主密钥：
#   python -c "import secrets; print(secrets.token_hex(16))"
# 加密明文：
#   CONFIG_DECRYPT_KEY=<32位hex> python scripts/encrypt_secret.py "<明文>"
# 不带 ENC(...) 前缀的值视为明文（向后兼容），此时 CONFIG_DECRYPT_KEY 可留空。
CONFIG_DECRYPT_KEY=
JWT_SECRET=ENC(<run scripts/encrypt_secret.py to generate>)
JWT_EXPIRE_HOURS=8

# 第三方管理系统登录校验接口
# AUTH_MOCK=true 时使用内置模拟数据,生产环境应改为 false 并配置真实接口
AUTH_MOCK=true
AUTH_API_URL=https://example.com/api/auth/verify

# Redis 会话存储配置
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=86400

# MySQL 会话持久化配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=ENC(<run scripts/encrypt_secret.py to generate>)
MYSQL_DATABASE=agentscope
UPLOAD_MAX_SIZE_MB=10

# Langfuse 可观测性配置（留空则不启用追踪）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=67108864
LOG_BACKUP_COUNT=7

# 管理中心配置（用户鉴权 / 意图卡片 地址分离）
MNG_AUTH_URL=
MNG_INTENT_URL=

# 外部技能目录（mng系统外部意图关联的skill存放路径）
EXTERNAL_SKILLS_DIR=

# OpenSandbox 沙箱配置
OPENSANDBOX_DOMAIN=localhost:9080
OPENSANDBOX_API_KEY=
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_USE_SERVER_PROXY=true
OPENSANDBOX_IMAGE=python:3.13-slim
OPENSANDBOX_RESOURCE_CPU=100m
OPENSANDBOX_RESOURCE_MEMORY=128Mi
# 工作区空闲 TTL（秒），供 OpenSandboxWorkspaceManager 淘汰空闲沙箱
WORKSPACE_TTL=3600
# 预热池：提前创建 N 个空闲沙箱，首次请求直接分配（0=不启用）
OPENSANDBOX_POOL_SIZE=0
# 池中沙箱被取出后是否自动补充
OPENSANDBOX_POOL_REFILL=true

# 知识库配置
RAGFLOW_API_KEY=
RAGFLOW_BASE_URL=

# 制度问答配置（policy_qa 技能）
# 权限名→知识库ID 映射（JSON，留空则用代码默认值）
POLICY_QA_KB_MAP=

# ---- 制度问答（regulations）配置 ----
# 制度问答模型在 config/model_config.yml 的 models.regulations_qa 配置（为空回退 default）
# 知识库检索服务（policy-kb-api）地址与内部 token
REGULATIONS_KB_API_BASE_URL=http://localhost:6183
REGULATIONS_KB_INTERNAL_TOKEN=
# 检索参数覆盖
REGULATIONS_TOP_K_OVERRIDE=20
REGULATIONS_RERANK_TOP_K_OVERRIDE=5
# Query 理解与改写开关
REGULATIONS_QUERY_UNDERSTANDING_ENABLED=true
REGULATIONS_QUERY_REWRITE_HYDE_ENABLED=true
REGULATIONS_QUERY_REWRITE_STEPBACK_ENABLED=true
REGULATIONS_QUERY_REWRITE_LLM_CLASSIFY_ENABLED=true
REGULATIONS_QUERY_REWRITE_BUSINESS_CLASSIFY_ENABLED=true
REGULATIONS_QUERY_REWRITE_BUSINESS_INTENTS_ENABLED=false
# 制度问答 Langfuse（与主项目同 host，独立公钥私钥/项目；密钥留空则禁用埋点）
REGULATIONS_LANGFUSE_PUBLIC_KEY=
REGULATIONS_LANGFUSE_SECRET_KEY=
REGULATIONS_LANGFUSE_ENABLED=true
REGULATIONS_LANGFUSE_SAMPLE_RATE=1.0
# 数据大盘（false=Mock，true=查真实 Langfuse/KB/缺口表）
REGULATIONS_DASHBOARD_USE_REAL_DATA=false
REGULATIONS_DASHBOARD_LOOKBACK_DAYS=30

# MinerU 文档解析配置（鉴权头为 x-api-key，非 Authorization）
MINERU_API_KEY=
MINERU_BASE_URL=
