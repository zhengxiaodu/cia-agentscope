      "schemaFields": "{\"title\":\"客户信息\",\"fields\":[{\"key\":\"customerName\",\"label\":\"客户名称\",\"type\":\"text\",\"placeholder\":\"请输入客户名称\"},{\"key\":\"accountType\",\"label\":\"账户类型\",\"type\":\"select\",\"options\":[\"产品户\",\"机构户\"]},{\"key\":\"contact\",\"label\":\"联系方式\",\"type\":\"text\",\"placeholder\":\"手机号或邮箱\"}]}",
      "renderTemplate": "var fields = schema.fields || []; var inputs = fields.map(function (f) { var input = f.type === 'select' ? '<select data-form-field=\"' + f.key + '\" style=\"width:100%;padding:8px 10px;border:1px solid #e5e7eb;border-radius:8px\">' + (f.options || []).map(function (o) { return '<option value=\"' + o + '\">' + o + '</option>'; }).join('') + '</select>' : '<input data-form-field=\"' + f.key + '\" type=\"text\" placeholder=\"' + (f.placeholder || '') + '\" style=\"width:100%;padding:8px 10px;border:1px solid #e5e7eb;border-radius:8px\">'; return '<label style=\"display:block;margin-bottom:10px\"><span style=\"display:block;font-size:12px;color:#64748b;margin-bottom:4px\">' + f.label + '</span>' + input + '</label>'; }).join(''); return '<div style=\"border:1px solid #e5e7eb;border-radius:16px;padding:16px;background:#fff\"><div style=\"font-size:16px;font-weight:700;color:#0f172a;margin-bottom:12px\">' + (schema.title || '请填写') + '</div>' + inputs + '<div style=\"display:flex;gap:8px;margin-top:12px\"><button class=\"sp-form-submit-btn\" style=\"flex:1;padding:10px;background:#2563eb;color:#fff;border:none;border-radius:10px;font-weight:600;cursor:pointer\">提交</button><button class=\"sp-form-cancel-btn\" style=\"flex:1;padding:10px;background:#f1f5f9;color:#475569;border:none;border-radius:10px;font-weight:600;cursor:pointer\">取消</button></div></div>';",
