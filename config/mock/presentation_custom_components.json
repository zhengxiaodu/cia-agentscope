      "schemaFields": "{\"title\":\"FICC 业务办理\",\"subtitle\":\"FICC 场外衍生品业务 · 请选择办理类型\",\"options\":[{\"label\":\"准入与账户开立\",\"value\":\"access\"},{\"label\":\"适当性重新准入\",\"value\":\"reaccess\"}]}",
      "renderTemplate": "var items = schema.options || []; var btns = items.map(function (it, i) { return '<div class=\"sp-confirm-btn\" data-confirm-msg=\"' + (it.value || it.label) + '\" onclick=\"selectPreviewItem(' + i + ')\" style=\"display:flex;align-items:center;gap:10px;padding:14px 16px;border:1px solid #e5e7eb;border-radius:12px;cursor:pointer;margin-bottom:8px\"><span style=\"font-size:15px;font-weight:600;color:#0f172a\">' + it.label + '</span></div>'; }).join(''); return '<div style=\"border:1px solid #e5e7eb;border-radius:16px;padding:16px;background:#fff\"><div style=\"font-size:16px;font-weight:700;color:#0f172a;margin-bottom:4px\">' + (schema.title || '请确认') + '</div><div style=\"font-size:13px;color:#64748b;margin-bottom:12px\">' + (schema.subtitle || '') + '</div>' + btns + '</div>';",
      "triggerRule": "true",
      "fallbackType": "text",
      "isEnabled": 1,
      "sortOrder": 1
    },
    {
      "id": 102,
